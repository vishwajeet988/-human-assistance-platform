{
  "name": "@hap/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/phase1.test.ts test/phase3.test.ts test/phase4.test.ts test/phase5.test.ts test/phase6.test.ts test/phase7.test.ts test/phase8.test.ts test/phase9.test.ts",
    "format:check": "node --check src/server.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.0.0",
    "@types/pg": "^8.23.1",
    "fastify": "^5.0.0",
    "pg": "^8.23.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
